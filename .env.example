# Backend/API
NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://dynamic_nft:dynamic_nft@localhost:5432/dynamic_nft_krnl
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
GLOBAL_METADATA_BASE_URI=http://localhost:8000/metadata/
TRAIT_METADATA_URI=http://localhost:8000/traits/metadata.json
DEMO_MODE=true
INTERNAL_API_KEY=replace-with-local-internal-api-key
PRIVY_APP_ID=replace-with-privy-app-id
PRIVY_API_KEY=replace-with-privy-api-key
PRIVY_JWT_VERIFICATION_KEY=replace-with-privy-jwt-verification-key
WORKFLOW_TEMPLATES_DIR=./packages/workflows/workflows
KRNL_NODE_URL=https://krnl-node.example
KRNL_RPC_METHOD=krnl_submitWorkflow
KRNL_RPC_STATUS_METHOD=krnl_workflowStatus
KRNL_DEFAULT_CHAIN_ID=11155111
RPC_SEPOLIA_URL=https://sepolia.example
SEPOLIA_RPC_URL=https://sepolia.example
KRNL_SENDER_ADDRESS=0x0000000000000000000000000000000000000000
KRNL_SENDER_PRIVATE_KEY=replace-with-dev-only-private-key
KRNL_DELEGATED_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
KRNL_ATTESTOR_URL=https://attestor.example
PIMLICO_API_KEY=replace-with-pimlico-api-key
KRNL_BUNDLER_URL=https://bundler.example
KRNL_PAYMASTER_URL=https://paymaster.example
KRNL_GAS_LIMIT=1000000
KRNL_MAX_FEE_PER_GAS=1000000000
KRNL_MAX_PRIORITY_FEE_PER_GAS=100000000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dynamic-nft-assets
S3_PUBLIC_BASE_URL=http://localhost:9000/dynamic-nft-assets
XP_PER_LOOTKEY=100
XP_PRICE_PER_LOOTKEY=100
ZEALY_API_BASE_URL=https://api.zealy.io

# Frontend/Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PRIVY_APP_ID=replace-with-privy-app-id
